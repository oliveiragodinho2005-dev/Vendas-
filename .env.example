# Copie para .env e preencha os valores. O arquivo .env esta no .gitignore
# e nunca deve ser versionado.
#
#   cp .env.example .env

# --- Banco de dados (lido pelo docker-compose e pela aplicacao) ---
POSTGRES_DB=apostas
POSTGRES_USER=apostas
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_PORT=5432

DB_URL=jdbc:postgresql://localhost:5432/apostas
DB_USER=apostas
DB_PASSWORD=troque-esta-senha

# --- Chaves de API (usadas a partir da Fase 2) ---
# API-Football: calendario, times e resultados do Brasileirao Serie A
API_FOOTBALL_KEY=
# The Odds API: odds agregadas de bet365 e Pinnacle
ODDS_API_KEY=

# --- Aplicacao ---
SERVER_PORT=8080
